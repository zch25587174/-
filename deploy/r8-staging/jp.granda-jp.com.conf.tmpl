# GrandA R8 STAGING — jp.granda-jp.com -> R7 on 127.0.0.1:__R7_PORT__
# Managed by deploy/r8-staging/r8_apply.sh. Affects ONLY server_name __DOMAIN__.
# Does not touch any other vhost, global directive, or certificate.

limit_req_zone $binary_remote_addr zone=granda_r8_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_ROOT__;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:granda_r8_ssl:5m;

    server_tokens off;
    autoindex off;
    client_max_body_size 20m;

    # STAGING: never indexable. No includeSubDomains on HSTS (would affect other hosts).
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Secrets, VCS metadata, backups, dumps, logs: never served.
    location ~ /\.(?!well-known/) { return 404; }
    location ~* \.(env|sql|sqlite|sqlite3|db|dump|bak|backup|old|orig|swp|log|tar|tgz|gz|zip|7z|rar|ini|conf|pem|key)$ { return 404; }
    location ~* ^/(backups?|dumps?|logs?|node_modules|storage/logs)(/|$) { return 404; }

    # Brute-force protection on admin login (app-level limits still apply).
    location ~* ^/admin/(login|auth|session) {
        limit_req zone=granda_r8_login burst=5 nodelay;
        limit_req_status 429;
        include __PROXY_SNIPPET__;
    }

    location / {
        include __PROXY_SNIPPET__;
    }
}
