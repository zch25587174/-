# GrandA R8 STAGING — __DOMAIN__ -> R7 on 127.0.0.1 (see granda-r8-proxy.inc)
# Rendered by deploy/r8-staging/r8_apply.sh; do not edit on the server.
# Affects ONLY server_name __DOMAIN__, plus a reject-only default sink on sockets that had
# no listener at all. Never default_server for __DOMAIN__; never listen-level http2.

__SINKS__

server {
    __LISTEN_HTTP__
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_ROOT__;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
# @@HTTPS_BEGIN

__LOGIN_ZONE__

server {
    __LISTEN_HTTPS__
    __HTTP2__
    server_name __DOMAIN__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:granda_r8_ssl:5m;

    server_tokens off;
    autoindex off;
    client_max_body_size 20m;

    # STAGING: never indexable. No includeSubDomains on HSTS (would affect other hosts).
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Secrets, VCS metadata, backups, dumps, logs: never served (lists live in r8_lib.sh).
    location ~ /\.(?!well-known/) { return 404; }
    location ~* \.(__BLOCKED_EXTS__)$ { return 404; }
    location ~* ^/(__BLOCKED_DIRS__)(/|$) { return 404; }

    # Admin login rate limit: only rendered when R7_ADMIN_LOGIN_PATH is supplied.
    __LOGIN_LOCATION__

    location / {
        include __PROXY_SNIPPET__;
    }
}
# @@HTTPS_END
